# Build directories
build/
build-*/
out/
cmake-build-*/

# CMake artifacts
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# Object / dependency files
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.d
*.dSYM/

# PlatformIO (firmware phase)
.pio/
.pioenvs/
.piolibdeps/
.vscode/extensions.json

# Editor / IDE — ignore personal .vscode bits, but track the shared
# build/flash/run/debug configs (portable, ${workspaceFolder}-relative).
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local config / secrets
.env
.env.local
config.local.*

# Personal working notes / handoff docs (kept locally, not published).
# Public docs live in README.md, ROADMAP.md, and docs/*.md.
docs/local/

# Dear ImGui persists window layout here — local UI state, not source.
imgui.ini

# Captures from live debugging (keep the canonical ones in captures/)
*.pcap
*.pcapng
!captures/*.pcapng
